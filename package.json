{
  "name": "pagedex",
  "version": "0.1.13",
  "description": "Local-first Markdown knowledge viewer, editor, Git bridge, and MCP v2 server for any directory.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quanhua92/pagedex.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "pagedex": "./bin/pagedex.js"
  },
  "files": [
    "bin/",
    "src/server/",
    "dist/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "dev": "node src/server/dev.js",
    "vault": "PAGEDEX_ROOT=$HOME/vault HOST=0.0.0.0 PAGEDEX_AUTH_TOKEN_FILE=$HOME/.config/pagedex/auth-token PAGEDEX_MCP_TOKEN_FILE=$HOME/.config/pagedex/mcp-token pnpm dev",
    "dev:server": "node --no-warnings --watch src/server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --no-warnings src/server/index.js",
    "prepublishOnly": "vite build",
    "test": "node --no-warnings --test test/*.test.js",
    "test:playwright": "node --no-warnings --test test/playwright/*.spec.js",
    "smoke": "node --no-warnings test/smoke.js all",
    "smoke:api": "node --no-warnings test/smoke.js api",
    "smoke:mcp": "node --no-warnings test/smoke.js mcp"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.7.0",
    "lucide-react": "^1.73.0",
    "marked": "^15.0.0",
    "mermaid": "^12.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "playwright-core": "^1.64.1",
    "vite": "^6.3.0"
  }
}
